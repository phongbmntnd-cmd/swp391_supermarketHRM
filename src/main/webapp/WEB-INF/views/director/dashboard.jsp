.2s; border-left: 4px solid #3498db; }        .card:hover { transform: translateY(-5px); box-shadow: 0 6px 12px rgba(0,0,0,0.1); }        .card h3 { font-size: 18px; color: #2c3e50; margin-bottom: 10px; }        .card p { font-size: 14px; color: #7f8c8d; margin-bottom: 20px; line-height: 1.4; }                /* Action Button inside Card */        .card-link { display: inline-block; background-color: #3498db; color: white; padding: 8px 16px; border-radius: 4px; text-decoration: none; font-size: 14px; font-weight: 500; transition: background-color 0.2s; }        .card-link:hover { background-color: #2980b9; }                .card.disabled { border-left-color: #bdc3c7; opacity: 0.7; }        .card.disabled .card-link { background-color: #95a5a6; pointer-events: none; }    </style></head><body>    <!-- Thanh điều hướng phía trên -->    <div class="top-navbar">        <h1>Quản Trị Hệ Thống - Giám Đốc Chuỗi</h1>        <div class="user-info">            <span>Xin chào, <b>${sessionScope.account.username}</b></span>            <a href="${pageContext.request.contextPath}/login.jsp" class="btn-logout">Đăng xuất</a>        </div>    </div>    <!-- Nội dung chính -->    <div class="container">                <!-- Banner chào mừng -->        <div class="welcome-card">            <h2>Tổng quan hệ thống chuỗi siêu thị</h2>            <p>Chào mừng bạn quay trở lại bảng điều khiển quản trị. Từ đây, bạn có thể giám sát toàn bộ hoạt động kinh doanh, quản lý danh sách chi nhánh và phân bổ nhân sự cho các cơ sở.</p>        </div>        <!-- Khối chức năng (Cards) -->        <div class="menu-grid">                        <!-- Chức năng 1: Quản lý chi nhánh (Đã có code) -->            <div class="card">                <h3>Quản lý danh sách chi nhánh</h3>                <p>Xem thông tin chi tiết, thêm mới cơ sở siêu thị và chỉ định Quản lý cửa hàng (Store Manager) phụ trách.</p>                <a href="${pageContext.request.contextPath}/director/branch-management" class="card-link">Truy cập quản lý →</a>            </div>            <!-- Chức năng 2: Báo cáo tổng quan (Sắp phát triển) -->            <div class="card disabled">                <h3>Báo cáo tổng quan toàn chuỗi</h3>                <p>Theo dõi biểu đồ doanh thu, hiệu suất làm việc và thống kê tổng quan nhân sự tại 3 cơ sở chính.</p>                <a href="#" class="card-link">Sắp ra mắt</a>            </div>        </div>    </div></body></html>