<?xml version="1.0" encoding="UTF-8"?>
<web-app version="6.0" xmlns="https://jakarta.ee/xml/ns/jakartaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd">
    <servlet>
        <servlet-name>StoreManagerBranchEmployeesServlet</servlet-name>
        <servlet-class>controller.StoreManagerBranchEmployeesServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>StoreManagerProposalServlet</servlet-name>
        <servlet-class>controller.StoreManagerProposalServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>StoreManagerAttendanceServlet</servlet-name>
        <servlet-class>controller.StoreManagerAttendanceServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>StoreManagerBranchEmployeesServlet</servlet-name>
        <url-pattern>/StoreManagerBranchEmployeesServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>StoreManagerProposalServlet</servlet-name>
        <url-pattern>/StoreManagerProposalServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>StoreManagerAttendanceServlet</servlet-name>
        <url-pattern>/StoreManagerAttendanceServlet</url-pattern>
    </servlet-mapping>
    <session-config>
        <session-timeout>
            30
        </session-timeout>
    </session-config>
    <!-- THÊM ĐOẠN NÀY VÀO ĐÂY -->
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>
</web-app>
